# Copy this file to node-backend/.env and set values for your local MySQL server.
PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_printing_db

# Replace with a unique random value of at least 32 characters.
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters

# Backend-only secret required to create the first admin account.
ADMIN_INITIAL_SETUP_SECRET=replace-this-with-a-long-random-admin-access-id
